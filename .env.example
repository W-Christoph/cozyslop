# Public IP address of the server; browsers send media to it.
PUBLIC_IP=203.0.113.10

# Shared secret between the CozyCast server and the room containers.
# Generate one with: openssl rand -hex 32
NEKO_API_TOKEN=

# Password for the "admin" account, created on first start.
ADMIN_PASSWORD=

# Domain name for automatic HTTPS (Let's Encrypt). Leave empty for plain HTTP.
# DOMAIN=cozy.example.com
# ACME_EMAIL=you@example.com

# Optional
# HTTP_PORT=80
# HTTPS_PORT=443
# Default desktop size; admins can change it per room in the room settings.
# SCREEN=1280x720@30
# x264 speed preset: faster presets use less CPU for slightly bigger streams.
# X264_PRESET=veryfast
