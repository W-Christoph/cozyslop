# Public IP address of the server; browsers send media to it.
PUBLIC_IP=203.0.113.10

# Secret shared by the CozyCast server and the room containers; each room's
# neko admin token is derived from it.
# Generate one with: openssl rand -hex 32
NEKO_API_TOKEN=

# Password for the "admin" account, created on first start.
ADMIN_PASSWORD=

# Domain name for automatic HTTPS (Let's Encrypt). Leave empty for plain HTTP.
# DOMAIN=cozy.example.com
# ACME_EMAIL=you@example.com

# Optional
# For opt-in room restarts from the UI, uncomment the Docker control lines
# in compose.yaml and set the host Docker socket's group ID here.
# Find the usual Docker group ID with: getent group docker | cut -d: -f3
# DOCKER_GID=
# HTTP_PORT=80
# HTTPS_PORT=443
# Media port of the default room (UDP and TCP must both be open).
# MEDIA_PORT=52000
# Default desktop size for all rooms; clearing a room screen setting restores it.
# Admins can override it per room in the room settings.
# SCREEN=1280x720@30
# Stream choices offered in the room settings: bitrates in kbit/s, stream
# sizes in percent of the desktop resolution, and x264 speed presets (fastest
# first; faster presets use less CPU but look blockier at the same bitrate).
# Changing these needs `docker compose up -d` to recreate the room.
# STREAM_BITRATES=1000 1500 2500 4000 6000 8000
# STREAM_SCALES=100 75 67 50
# X264_PRESETS=ultrafast superfast veryfast
# Preset of the default stream, for rooms that never picked one.
# X264_PRESET=veryfast
