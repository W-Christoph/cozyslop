# Public IP address of the server; browsers send media to it.
PUBLIC_IP=203.0.113.10

# Secret shared by the CozyCast server and the room containers; each room's
# neko admin token is derived from it.
# Generate one with: openssl rand -hex 32
NEKO_API_TOKEN=

# Password for the "admin" account, created on first start.
ADMIN_PASSWORD=

# Domain name for automatic HTTPS (Let's Encrypt). Leave empty for plain HTTP.
# DOMAIN=cozy.example.com
# ACME_EMAIL=you@example.com

# Optional
# Compose files added to compose.yaml, joined with ":":
#   compose.tunnel.yaml          rooms on other computers (docs/home-hosting.md)
#   compose.no-room.yaml         no room on the server itself, for a small
#                                server: a room is what needs CPU and memory
#   compose.room-on-demand.yaml  the server's room stays stopped until an admin
#                                starts it under Admin > Rooms; needs
#                                DOCKER_GID below, the steps are in that file
# COMPOSE_FILE=compose.yaml:compose.tunnel.yaml
# For opt-in room restarts from the UI, uncomment the Docker control lines
# in compose.yaml and set the host Docker socket's group ID here.
# Find it with: stat -c %g /var/run/docker.sock
# DOCKER_GID=
# HTTP_PORT=80
# HTTPS_PORT=443
# Seconds a room stays empty (nobody on its page) before the programs on its
# desktop are paused, so that a video left playing does not keep the machine
# busy. Whoever joins next wakes them; windows and tabs stay as they were.
# 0 = never. Applies to rooms on other computers too.
# HIBERNATE_AFTER=60
# Media port of the default room (UDP and TCP must both be open).
# MEDIA_PORT=52000
# Default desktop size of the rooms on this server; clearing a room screen
# setting restores it. Admins can override it per room in the room settings.
# A room on another computer starts with that computer's (.env.node there).
# SCREEN=1280x720@30
# Stream choices offered in the room settings: bitrates in kbit/s, stream
# sizes in percent of the desktop resolution, and x264 speed presets (fastest
# first; faster presets use less CPU but look blockier at the same bitrate).
# Changing these needs `docker compose up -d` to recreate the room.
# STREAM_BITRATES=1000 1500 2500 4000 6000 8000
# STREAM_SCALES=100 75 67 50
# X264_PRESETS=ultrafast superfast veryfast
# The default stream, for rooms that never picked one: bitrate, stream size
# and preset.
# STREAM_BITRATE=2500
# STREAM_SCALE=100
# X264_PRESET=veryfast
